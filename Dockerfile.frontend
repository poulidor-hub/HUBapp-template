# Stage 1: Build React app
FROM node:20-alpine AS builder

# Version de l'application (passée au build)
ARG APP_VERSION=0.0.0

WORKDIR /app

# Copier le fichier VERSION pour injecter la vraie version au build Vite
COPY VERSION /tmp/VERSION

# Copier les fichiers de dépendances
COPY frontend/package.json frontend/package-lock.json* ./

# Installer les dépendances
RUN npm install

# Copier le code source
COPY frontend/ .

# Arguments de build (passés par docker-compose)
ARG VITE_API_PORT=9045
ARG VITE_HUB_API_PORT=8000
ARG VITE_HUB_FRONTEND_PORT=80
ARG VITE_APP_SLUG=mon-app

# Variables d'environnement pour le build Vite
ENV VITE_API_PORT=$VITE_API_PORT
ENV VITE_HUB_API_PORT=$VITE_HUB_API_PORT
ENV VITE_HUB_FRONTEND_PORT=$VITE_HUB_FRONTEND_PORT
ENV VITE_APP_SLUG=$VITE_APP_SLUG

# Build de production
RUN RESOLVED_APP_VERSION="$(cat /tmp/VERSION 2>/dev/null || echo "$APP_VERSION")" \
	&& export VITE_APP_VERSION="$RESOLVED_APP_VERSION" \
	&& npm run build

# Stage 2: Serveur nginx
FROM nginx:alpine

# Installer openssl pour le support HTTPS
RUN apk add --no-cache openssl

# Version de l'application
ARG APP_VERSION=0.0.0
LABEL version="${APP_VERSION}"
LABEL maintainer="HUBapp Template"

# Créer le dossier SSL
RUN mkdir -p /etc/nginx/ssl

# Copier les configurations nginx (HTTP et HTTPS)
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx-ssl.conf /etc/nginx/nginx-ssl.conf.template

# Copier l'entrypoint
COPY frontend/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Copier les fichiers buildés depuis le stage builder
COPY --from=builder /app/dist /usr/share/nginx/html

# === Durcissement (audit sécurité #21) — pattern HUB_base/frontend ===
# Conteneur 100% non-root : nginx tourne en utilisateur "nginx" (uid 101).
# - les répertoires de cache/logs et conf.d sont chownés au build (nginx y écrit
#   au runtime sans jamais avoir besoin de CAP_CHOWN/CAP_DAC_OVERRIDE) ;
# - le compose fournit uniquement CAP_NET_BIND_SERVICE pour binder 80/443 ;
# - l'entrypoint (docker-entrypoint.sh) reste compatible : il écrit dans
#   /etc/nginx/conf.d (chowné) et /tmp (1777).
# NB : l'auto-génération de certificats dans /etc/nginx/ssl nécessite un montage
# rw accessible à l'uid 101 (le montage par défaut ./ssl:ro impose `make ssl`).
RUN chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid

USER nginx

# Exposer les ports HTTP et HTTPS
EXPOSE 80 443

ENTRYPOINT ["/docker-entrypoint.sh"]
