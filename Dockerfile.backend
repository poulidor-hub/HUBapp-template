# HUBapp Template — app fine de démonstration sur socle POULIDOR
# Le socle (poulidor/socle-api) fournit tout le transverse : auth, config,
# database, hub_client, backup, outbox, routes core/items/preferences…
# L'app n'ajoute QUE son métier (ici : rien — c'est la démo du socle).
ARG SOCLE_VERSION
FROM poulidor/socle-api:${SOCLE_VERSION}
COPY backend/ /app/
COPY VERSION /app/VERSION

# depends.yaml — lu par le socle (_load_depends_yaml : backend/ puis racine
# /app) et poussé au Hub à chaque register (_push_deps_to_hub, best-effort).
# Sans COPY, la déclaration de dépendances n'atteint jamais le dashboard
# Hub (parc : gap constaté et corrigé sur Transmission/exemple-app/exemple-app
# le 11/11/2026 ; pattern exemple-V2).
COPY depends.yaml /app/depends.yaml
