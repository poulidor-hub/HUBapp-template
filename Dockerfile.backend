# === Stage 1: Builder — Installation des dépendances ===
FROM python:3.11-slim AS builder

WORKDIR /build

# Dépendances système pour compiler psycopg2
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Installer les dépendances Python dans un wheel cache
COPY backend/requirements.txt .
RUN pip wheel --no-cache-dir --wheel-dir /build/wheels -r requirements.txt


# === Stage 2: Runtime — Image finale légère ===
FROM python:3.11-slim

# Version de l'application (passée au build)
ARG APP_VERSION=0.0.0
LABEL version="${APP_VERSION}"
LABEL maintainer="HUBapp Template"

WORKDIR /app

# Dépendances runtime uniquement (pas gcc)
RUN apt-get update && apt-get install -y \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Installer les wheels pré-compilés
COPY --from=builder /build/wheels /tmp/wheels/
COPY backend/requirements.txt .
RUN pip install --no-cache-dir /tmp/wheels/* && rm -rf /tmp/wheels/

# Créer un utilisateur non-root (aligné avec le HUB)
RUN useradd -m -u 1000 appuser

# Copier le code source
# (AVANT le VERSION : un backend/VERSION parasite — mountpoint créé par le
# montage ./VERSION:/app/VERSION:ro du compose dev — ne doit jamais écraser
# la source unique de vérité ; .dockerignore l'exclut aussi par précaution)
COPY backend/ .

# Copier le fichier VERSION (source unique de vérité)
COPY VERSION /app/VERSION

# Rendre l'entrypoint exécutable
RUN chmod +x /app/entrypoint.sh

# Créer les répertoires nécessaires et donner les permissions
RUN mkdir -p /app/uploads /app/storage && chown -R appuser:appuser /app

# Passer en utilisateur non-root
USER appuser

# Port exposé (HTTP)
EXPOSE 8000

# Utiliser l'entrypoint pour installer le certificat CA avant de lancer l'app
ENTRYPOINT ["/app/entrypoint.sh"]
