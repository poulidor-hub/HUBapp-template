# Backend API
FROM python:3.11-slim

# Version de l'application (passée au build)
ARG APP_VERSION=0.0.0
LABEL version="${APP_VERSION}"
LABEL maintainer="HUBapp Template"

WORKDIR /app

# Dépendances système pour psycopg2 et healthcheck
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copier les requirements et installer
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copier le fichier VERSION (source unique de vérité)
COPY VERSION /app/VERSION

# Copier le code source
COPY backend/ .

# Copier le CHANGELOG pour les endpoints de documentation
COPY CHANGELOG.md /app/CHANGELOG.md

# Rendre l'entrypoint exécutable
RUN chmod +x /app/entrypoint.sh

# Port exposé (HTTP)
EXPOSE 8000

# Utiliser l'entrypoint pour installer le certificat CA avant de lancer l'app
ENTRYPOINT ["/app/entrypoint.sh"]
