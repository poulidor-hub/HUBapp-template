# HUBapp Template — app fine de démonstration sur socle POULIDOR
# Le socle (poulidor/socle-api) fournit tout le transverse : auth, config,
# database, hub_client, backup, outbox, routes core/items/preferences…
# L'app n'ajoute QUE son métier (ici : rien — c'est la démo du socle).
ARG SOCLE_VERSION
FROM poulidor/socle-api:${SOCLE_VERSION}
COPY backend/ /app/
COPY VERSION /app/VERSION
