# Backend API
FROM python:3.11-slim

# Version de l'application (passée au build)
ARG APP_VERSION=0.0.0
LABEL version="${APP_VERSION}"
LABEL maintainer="HUBapp Template"

WORKDIR /app

# Dépendances système pour psycopg2 et ca-certificates
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Créer le répertoire pour le certificat CA Hub
RUN mkdir -p /app/certs

# Copier les requirements et installer
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copier le fichier VERSION (source unique de vérité)
COPY VERSION /app/VERSION

# Copier le code source
COPY backend/ .

# Copier le CHANGELOG pour les endpoints de documentation
COPY CHANGELOG.md /app/CHANGELOG.md

# Note: Le certificat CA du Hub (hub-ca.crt) est fourni dynamiquement par le Hub
# et monté via docker-compose.yml dans /app/certs/hub-ca.crt
# L'entrypoint l'installe au niveau système au démarrage si HTTPS est activé

# Rendre l'entrypoint exécutable
RUN chmod +x /app/entrypoint.sh

# Ports exposés (internes au container)
# 8000 = HTTP, 8443 = HTTPS (si certificats disponibles)
EXPOSE 8000
EXPOSE 8443

# Utiliser l'entrypoint pour installer le certificat CA avant de lancer l'app
ENTRYPOINT ["/app/entrypoint.sh"]
