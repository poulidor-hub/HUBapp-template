# ============================================================
# Configuration de l'application Template Hub
# ============================================================
# Copier ce fichier vers .env et adapter les valeurs

# === OBLIGATOIRE ===
# Identifiant unique de l'application (sans espaces, minuscules)
APP_SLUG=mon-app
APP_NAME=Mon Application
APP_DESCRIPTION=Application template avec authentification Hub

# === VERSION ===
# Synchronisé automatiquement depuis le fichier VERSION par `scripts/bump_version.py`
# Ne pas modifier manuellement sauf besoin exceptionnel
APP_VERSION=2.35.0

# === SOCLE POULIDOR ===
# App fine : Dockerfile.backend → FROM poulidor/socle-api:${APP_SOCLE_VERSION}.
# `make sync-env` (donc make build / make up / make dev) aligne automatiquement
# cette valeur sur le checkout HUBsocle du parc (sinon : message actionnable
# « lancez ./hubctl socle build »). Ne pas éditer à la main.
APP_SOCLE_VERSION=2.28.0

# === PORTS ===
# Laisser VIDE pour une allocation automatique par le Hub à la première
# exécution de `make up` / `make dev` (le Hub puise dans son pool).
# Renseigner une valeur pour forcer un port manuel.
# Port de l'API backend
API_PORT=
# Port du frontend (serveur statique)
FRONTEND_PORT=
# Port HTTPS du frontend (= FRONTEND_PORT + 1, rempli par `make sync-env`)
FRONTEND_HTTPS_PORT=

# === RÉSEAU DOCKER ===
# Sous-réseau Docker de l'app (CIDR, ex: 10.50.0.0/24).
# Laisser VIDE pour une allocation automatique par le Hub à la première
# exécution de `make up` / `make build` (pool APP_SUBNET_POOL du Hub).
# Obligatoire pour le réseau app-network du docker-compose : le pool Docker
# par défaut est saturé et retomberait sur 192.168.16.0/20, en conflit avec
# le VPN WireGuard du routeur (192.168.27.0/24).
APP_SUBNET=

# === HTTPS ===
# Mode HTTPS activé PAR DÉFAUT : `make up` génère automatiquement les
# certificats auto-signés (scripts/generate-ssl.sh, couvre localhost + IP
# locale) puis charge docker-compose.https.yml (port HTTPS = FRONTEND_PORT+1).
# Pour un certificat signé (domaine public), déposez-le dans ssl/ et
# regénérez uniquement si l'IP du serveur change : ./scripts/generate-ssl.sh --force
HTTPS_ENABLED=true

# === HOST DE CETTE APPLICATION ===
# IP ou hostname par lequel cette application sera accessible
# 
# CAS 1 - App sur le MÊME serveur que le Hub :
#   Laisser vide → utilisera automatiquement HUB_HOST
#
# CAS 2 - App sur un serveur DIFFÉRENT du Hub :
#   Définir l'IP du serveur où l'app est déployée (ex: 192.168.1.200)
#   Cette IP sera transmise au Hub lors de l'enregistrement
#
# NOTE: Cette IP est utilisée pour construire les URLs de l'app (API, frontend, callback)
APP_HOST=

# === HUB ===
# IP/hostname du serveur Hub.
# Synchronisée automatiquement par `make sync-env` (découverte via GET /api/config/hub-host).
# Forçage manuel : `make sync-hub-host` (guidé interactif) ou `make sync-hub-host HUB_HOST=x.x.x.x`.
HUB_HOST=192.0.2.11
# Host interne utilisé par le backend pour joindre le Hub depuis Docker.
# Laisser vide pour utiliser HUB_HOST (recommandé si tout est sur le même serveur).
HUB_INTERNAL_HOST=
HUB_API_PORT=8000
HUB_FRONTEND_PORT=80

# === BASE DE DONNÉES ===
POSTGRES_HOST=mon-app-postgres
# Port INTERNE de PostgreSQL (conteneur). Reste 5432 sauf conflit réseau spécifique ;
# propagé automatiquement à l'API (POSTGRES_PORT) et au conteneur postgres (PGPORT).
POSTGRES_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password_secure_123
POSTGRES_DB=app_db

# === ENVIRONNEMENT ===
DEBUG=false

# === LOGGING ===
# Niveau de log applicatif (DEBUG, INFO, WARNING, ERROR). Les logs sont
# horodatés à l'heure du Hub (UTC, ISO 8601) — resynchronisés toutes les
# HUB_TIME_SYNC_INTERVAL secondes ; fallback heure locale UTC si hub injoignable.
LOG_LEVEL=INFO
HUB_TIME_SYNC_INTERVAL=300

# Endpoints démo (tests, test-data) — désactivés par défaut en production
ENABLE_DEMO_ENDPOINTS=false

# === M2M (MACHINE-TO-MACHINE) ===
# Permettre l'accès aux ressources via le système M2M du Hub
# Si true, d'autres applications pourront accéder à cette app via tokens M2M
IS_SHARED=false

# === CORS (OPTIONNEL) ===
# Liste d'origines autorisées séparées par des virgules
# Laisser vide pour auto-détection basée sur APP_HOST et FRONTEND_PORT
# CORS_ORIGINS=http://localhost:4250,https://monapp.fr
