# ============================================================
# Configuration de l'application Template Hub
# ============================================================
# Copier ce fichier vers .env et adapter les valeurs

# === OBLIGATOIRE ===
# Identifiant unique de l'application (sans espaces, minuscules)
APP_SLUG=mon-app
APP_NAME=Mon Application
APP_DESCRIPTION=Application template avec authentification Hub

# === PORTS ===
# Port de l'API backend
API_PORT=9898
# Port du frontend (serveur statique)
FRONTEND_PORT=7676

# === HUB ===
# Laisser vide pour auto-détection (même machine)
# Remplir si le Hub est sur une autre machine
HUB_HOST=192.170.50.62
HUB_API_PORT=8000
HUB_FRONTEND_PORT=80

# === BASE DE DONNÉES ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password_secure_123
POSTGRES_DB=app_db

# === ENVIRONNEMENT ===
DEBUG=false

# === M2M (MACHINE-TO-MACHINE) ===
# Permettre l'accès aux ressources via le système M2M du Hub
# Si true, les autres applications peuvent accéder aux données via leurs service accounts
IS_SHARED=false

# ============================================================
# VARIABLES HUB DISPONIBLES (NON UTILISÉES DANS CE TEMPLATE)
# ============================================================
# Ces variables sont compatibles avec le Hub mais non implémentées
# dans ce template. Décommentez et adaptez selon vos besoins.

# === MULTI-TENANT / ORGANISATION ===
# Pour les déploiements multi-organisations
# ORGANIZATION_ID=
# WORKSPACE_ID=
# DEPARTMENT=

# === PARTAGE ET COLLABORATION ===
# Activer le partage d'items entre utilisateurs
# ENABLE_SHARING=false
# ENABLE_GROUPS=false
# ENABLE_TEAMS=false

# === FONCTIONNALITÉS AVANCÉES ===
# Catégorisation et tags
# ENABLE_TAGS=false
# ENABLE_CATEGORIES=false
# DEFAULT_CATEGORY=general

# Métadonnées personnalisées
# ENABLE_CUSTOM_FIELDS=false
# CUSTOM_FIELDS_SCHEMA={}

# === CHAMPS JWT ADDITIONNELS DISPONIBLES DU HUB ===
# Le token JWT du Hub peut contenir ces champs (non extraits par défaut) :
# - email : Email de l'utilisateur
# - display_name : Nom complet affiché
# - avatar_url : URL de l'avatar utilisateur
# - groups : Liste des groupes d'appartenance
# - department : Département/service de l'utilisateur
# - organization : Organisation de rattachement
# - permissions : Permissions granulaires spécifiques

# === CHAMPS MODÈLE ITEM DISPONIBLES (non implémentés) ===
# Ajoutez ces champs dans models.py et schemas.py si nécessaire :
# - shared_with (list[str]) : Liste des usernames ayant accès
# - tags (list[str]) : Étiquettes pour classification
# - category (str) : Catégorie de l'item
# - metadata (JSON) : Champs personnalisés libres
# - workspace_id (str) : Espace de travail associé
# - organization_id (str) : Organisation propriétaire
# - priority (int) : Niveau de priorité
# - status (str) : Statut de l'item (draft, active, archived)
# - parent_id (int) : ID du parent pour hiérarchie

# === PRÉFÉRENCES UTILISATEUR ADDITIONNELLES ===
# Champs pouvant être ajoutés à UserPreference :
# - timezone (str) : Fuseau horaire utilisateur
# - date_format (str) : Format de date préféré
# - notification_frequency (str) : daily, weekly, instant
# - dashboard_layout (JSON) : Configuration du tableau de bord